{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OASIS Inspection App",
  "version": "1.0.0",
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/Karuki00/inspection-oasis-desktop/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "identifier": "com.oasis.inspection",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OASIS Inspection System",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Apartemen Oasis Mitra Sarana",
    "homepage": "https://github.com/Karuki00/inspection-oasis-desktop"
  }
}